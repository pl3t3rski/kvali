{
  "name": "kvali",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run build:index -- --drafts && KVALI_INCLUDE_DRAFTS=1 ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "npm run build:index && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:drafts": "npm run build:index -- --drafts && KVALI_INCLUDE_DRAFTS=1 ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "fetch:route": "tsx scripts/fetch-route.ts",
    "compute:stats": "tsx scripts/compute-stats.ts",
    "fetch:photos": "tsx scripts/fetch-photos.ts",
    "enrich": "npm run fetch:route && npm run compute:stats && npm run fetch:photos",
    "build:index": "tsx scripts/build-index.ts",
    "validate": "tsx scripts/validate.ts",
    "check:links": "tsx scripts/check-links.ts",
    "reverify": "tsx scripts/reverify.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "astro": "^7.4.13",
    "fast-xml-parser": "^5.12.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
