---
/**
 * Main view: the map, the synced list and the filters, as one Svelte island
 * (src/components/MainView.svelte) on top of public/index.json and routes-lite.geojson.
 * Without JavaScript the page is a plain list of links to the trek pages.
 */
import MainView from '../components/MainView.svelte';
import { getSiteTreks } from '../data/site';
import Base from '../layouts/Base.astro';
import { formatCountries } from '../lib/format';
import { url } from '../lib/paths';

const treks = await getSiteTreks();
---

<Base fullscreen>
  <MainView client:only="svelte" />
  <noscript>
    <div class="page">
      <h1 class="t-heading kv-hand">Where to walk next</h1>
      <p class="t-body">The map needs JavaScript. Every trek is listed here.</p>
      <ul class="stack">
        {
          treks.map(({ trek }) => (
            <li>
              <a href={url(`/treks/${trek.id}/`)}>{trek.name}</a>
              <span class="t-caption"> {trek.region} · {formatCountries(trek.countries)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </noscript>
</Base>
