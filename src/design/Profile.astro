---
/**
 * The height of the route from one end to the other, drawn from the measured profile.
 * The line is not wobbled: every point is a measured height.
 */
import { formatKm, formatMetres } from '../lib/format';

interface Props {
  /** Heights in metres at evenly spaced points along the route. */
  profile: number[];
  distance_km: number;
  /** The measured lowest and highest points. The profile keeps only some of the heights, so it can miss them by a little. */
  lowest_m: number;
  highest_m: number;
}
const { profile, distance_km, lowest_m, highest_m } = Astro.props;

const WIDTH = 720;
const HEIGHT = 190;
const LEFT = 8;
const RIGHT = 8;
const TOP = 34;
const BOTTOM = 30;
const low = Math.min(...profile);
const high = Math.max(...profile);
// Leave room under the lowest point, so the shape reads as a mountain and not as a wave.
const floor = low - (high - low) * 0.25;
const x = (index: number) => LEFT + (index / (profile.length - 1)) * (WIDTH - LEFT - RIGHT);
const y = (metres: number) => TOP + (1 - (metres - floor) / (high - floor)) * (HEIGHT - TOP - BOTTOM);
const round = (value: number) => Math.round(value * 10) / 10;

const line = profile.map((metres, index) => `${index === 0 ? 'M' : 'L'}${round(x(index))} ${round(y(metres))}`).join('');
const area = `${line}L${round(x(profile.length - 1))} ${HEIGHT - BOTTOM}L${LEFT} ${HEIGHT - BOTTOM}Z`;
const top = profile.indexOf(high);
// Keep the label of the highest point inside the drawing.
const anchor = x(top) < 90 ? 'start' : x(top) > WIDTH - 90 ? 'end' : 'middle';
---

<svg class="profile" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-label={`Height along the route: between ${formatMetres(lowest_m)} and ${formatMetres(highest_m)} over ${formatKm(distance_km)}`}>
  <path class="area" d={area}></path>
  <path class="line" d={line}></path>
  <circle class="dot" cx={round(x(top))} cy={round(y(high))} r="4.5"></circle>
  <text class="number" x={round(x(top))} y={round(y(high)) - 12} text-anchor={anchor}>{formatMetres(highest_m)}</text>
  <text class="quiet" x={LEFT} y={HEIGHT - 8}>0 km</text>
  <text class="quiet" x={WIDTH - RIGHT} y={HEIGHT - 8} text-anchor="end">{formatKm(distance_km)}</text>
  <text class="quiet" x={WIDTH / 2} y={HEIGHT - 8} text-anchor="middle">lowest {formatMetres(lowest_m)}</text>
</svg>

<style>
  .profile {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-reading);
  }
  .area {
    fill: var(--paper-deep);
  }
  .line {
    fill: none;
    stroke: var(--pen);
    stroke-width: 2.6;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .dot {
    fill: var(--butter);
    stroke: var(--pen);
    stroke-width: 2.2;
  }
  .number {
    font-size: 15px;
    font-weight: 600;
    fill: var(--ink);
  }
  .quiet {
    font-size: 13px;
    fill: var(--ink-quiet);
  }
</style>
